{% set s = home.why %}
<section id="{{ s.id }}" class="section section-white why" aria-labelledby="{{ s.id }}-heading">
  <div class="container why-grid">
    <div class="why-art">
      <img class="framed-image" src="{{ s.image.src }}" width="{{ s.image.width }}" height="{{ s.image.height }}" alt="{{ s.image.alt }}" loading="lazy" decoding="async">
    </div>
    <div class="why-copy">
      <h2 id="{{ s.id }}-heading" class="section-heading">{{ s.heading }}</h2>
      <p class="lead">{{ s.text }}</p>
      <ul class="commitments" role="list">
        {% for item in s.items %}
        <li class="commitment">
          <h3 class="commitment-title">{{ item.title }}</h3>
          <p>{{ item.text }}</p>
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
